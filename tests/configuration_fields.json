{
  "destination.type": "mssql",
  "destination.server": "localhost,1433",
  "destination.database": "LegacyLanding",
  "destination.schema": "dbo",
  "destination.control_database": "IngestControl",
  "destination.bootstrap_database": "master",
  "destination.driver": "ODBC Driver 18 for SQL Server",
  "destination.authentication": "sql",
  "destination.encrypt": "yes",
  "destination.trust_server_certificate": "no",
  "destination.connect_timeout_seconds": 15,
  "destination.statement_timeout_seconds": 120,
  "destination.create_databases": true,
  "destination.create_schemas": true,
  "destination.create_tables": true,
  "source.root": "D:\\Exports",
  "source.path": "D:\\Exports",
  "source.recursive": true,
  "source.include": [
    "**/*.csv",
    "**/*.tsv",
    "**/*.txt",
    "**/*.xyz"
  ],
  "source.exclude": [
    "**/ingest-work/**",
    "**/*.tmp"
  ],
  "source.follow_symlinks": false,
  "source.format": "auto",
  "mapping.database_strategy": "single",
  "mapping.table_strategy": "per_file",
  "mapping.existing_target_strategy": "owned_landing",
  "mapping.target_table": "",
  "mapping.omit_target_columns": [],
  "mapping.identity_policy": "generate",
  "mapping.allow_target_triggers": false,
  "mapping.database_prefix": "Import_",
  "mapping.root_files": "root_database",
  "mapping.root_database": "LegacyLanding",
  "mapping.root_table": "root_records",
  "mapping.per_file_database_table": "data",
  "mapping.directory_merge_schema": "strict",
  "mapping.name_collision": "filename_error",
  "parsing.record_terminator": "auto",
  "parsing.allow_multiline_fields": true,
  "parsing.encoding": "auto",
  "parsing.delimiter": "auto",
  "parsing.quotechar": "auto",
  "parsing.escapechar": "none",
  "parsing.doublequote": true,
  "parsing.column_names": [],
  "parsing.header": "auto",
  "parsing.ambiguity_policy": "pause",
  "parsing.sample_records": 10000,
  "parsing.sample_bytes": 8388608,
  "parsing.nel_is_newline": false,
  "parsing.strict_decoding": true,
  "parsing.null_tokens": [],
  "parsing.null_tokens_case_sensitive": true,
  "parsing.null_tokens_in_quoted_fields": false,
  "parsing.empty_string_is_null": false,
  "parsing.trim_whitespace": false,
  "parsing.blank_record_policy": "quarantine",
  "parsing.ragged_row_policy": "quarantine",
  "parsing.repeated_header_policy": "preserve_as_data",
  "parsing.repair_policy": "none",
  "schema.inference": "full",
  "schema.text_fallback": "nvarchar",
  "schema.text_length_headroom_percent": 20,
  "schema.allow_max_types": true,
  "schema.new_columns_nullable": true,
  "schema.infer_defaults": false,
  "schema.numeric_policy": "exact",
  "schema.leading_zero_policy": "text",
  "schema.date_policy": "iso_unambiguous",
  "schema.timezone_policy": "preserve",
  "schema.fractional_second_policy": "preserve_exact",
  "schema.on_length_overflow": "ask",
  "schema.on_type_conflict": "retype_text",
  "schema.on_append_schema_mismatch": "pause",
  "schema.allow_add_columns_on_append": false,
  "schema.allow_widen_on_append": false,
  "schema.allow_retype_on_append": false,
  "schema.allow_lossy_projection": false,
  "load.mode": "append",
  "load.engine": "auto",
  "load.preferred_engine": "bcp",
  "load.fallback_engine": "odbc",
  "load.batch_rows": 5000,
  "load.batch_bytes": 8388608,
  "load.fast_executemany": true,
  "load.partial_publish": "new_or_append",
  "load.replace_requires_complete_input": true,
  "load.replace_scope": "complete_group",
  "load.allow_empty_replace": false,
  "load.retain_previous_generation": true,
  "load.target_lock_timeout_seconds": 60,
  "tools.bcp_path": "bcp",
  "tools.sqlcmd_path": "sqlcmd",
  "tools.sqlcmd_variant": "odbc",
  "tools.detect_versions": true,
  "tools.capture_stdout_stderr": true,
  "credentials.password_source": "prompt",
  "credentials.allow_password_in_child_args": false,
  "credentials.redact_secrets": true,
  "preservation.work_directory": "D:\\ingest-work",
  "preservation.capture_original_bytes": true,
  "preservation.hash": "sha256",
  "preservation.source_change_policy": "abort",
  "preservation.retain_originals": "indefinitely",
  "preservation.retain_journal": "indefinitely",
  "preservation.retain_failure_artifacts": "indefinitely",
  "preservation.cleanup_verified_transport_spools": false,
  "preservation.minimum_free_disk_bytes": 2147483648,
  "preservation.flush_durable_checkpoints": true,
  "audit.control_schema": "audit",
  "audit.failure_schema": "failures",
  "audit.create_failure_tables": true,
  "audit.failure_table_pattern": "{table}_fail_{utc_timestamp}_{run_short}",
  "audit.local_failure_fallback": true,
  "audit.mirror_receipts_after_commit": true,
  "audit.event_timestamps": "utc",
  "audit.json_log": true,
  "audit.console_log_level": "INFO",
  "audit.show_raw_errors": false,
  "audit.log_source_values": false,
  "verification.level": "full",
  "verification.sample_records": 10000,
  "verification.unresolved_policy": "block_affected_publication",
  "parallel.enabled": true,
  "parallel.max_workers": 2,
  "parallel.strategy": "files",
  "parallel.serialize_same_target_publication": true,
  "limits.total_process_tree_memory_bytes": 536870912,
  "limits.worker_memory_bytes": 201326592,
  "limits.max_in_memory_record_bytes": 8388608,
  "limits.max_in_memory_field_bytes": 8388608,
  "limits.max_queue_bytes": 16777216,
  "limits.fetch_bytes": 8388608,
  "limits.output_buffer_bytes": 32768,
  "limits.oversized_record_policy": "preserve_and_quarantine",
  "retry.max_attempts": 3,
  "retry.initial_backoff_seconds": 1,
  "retry.maximum_backoff_seconds": 15,
  "retry.jitter": true,
  "retry.require_commit_resolution": true,
  "interaction.non_interactive": false,
  "interaction.on_required_decision": "pause",
  "xml.enabled": false,
  "xml.record_selector": "",
  "xml.fields": [],
  "xml.allow_entities": false,
  "xml.allow_network": false,
  "xml.max_depth": 64,
  "html.enabled": false,
  "html.table_selector": "",
  "html.fields": [],
  "html.text_policy": "preserve",
  "html.allow_nested_tables": false,
  "html.allow_rowspan_colspan": false
}
